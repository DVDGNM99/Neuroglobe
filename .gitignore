# --- Python & System ---
__pycache__/
*.py[cod]
*$py.class
*.so
.DS_Store
Thumbs.db
Desktop.ini

# --- Build & Distribution ---
dist/
build/
*.egg-info/
.eggs/

# --- Environments & IDEs ---
.env
.venv
env/
venv/
.vscode/
.idea/
.spyderproject
.spyproject/

# --- Testing ---
.coverage
htmlcov/
.pytest_cache/
test_log.txt
*_log.txt
# (tests/ folder is KEPT by default)

# --- Logs ---
logs/
*.log

# --- Data ---
# Ignore all Source/Raw data...
data/raw/*
# ...BUT keep specific Demo Experiments for the Viewer
!data/raw/manifest.json
!data/raw/experiment_583747816/
!data/raw/experiment_480074702/

# In those kept raw demo folders, still ignore heavy volumes (optional but matches your issue)
data/raw/experiment_583747816/**/*.nrrd
data/raw/experiment_480074702/**/*.nrrd

# Keep Processed Data (Demo CSVs and Tracts) was previously "KEPT by default"
# but GitHub blocks very large scientific volumes/meshes: ignore them.
data/processed/tracts/**/*.nrrd
data/processed/tracts/**/*.vti
data/processed/tracts/**/*.vtk

# (Optional: if you also generate these)
data/processed/tracts/**/*.nii
data/processed/tracts/**/*.nii.gz

# --- Scenes / Output ---
scenes/

# --- Scripts ---
scripts/
